{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oxbot",
  "identifier": "dev.oxbot.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
